{
  "name": "agent-guardrails-kit",
  "version": "0.0.0",
  "description": "One command to put safety rails around AI coding agents: shared rules, hooks that block dangerous actions, git hooks and GitHub files.",
  "keywords": [
    "ai",
    "agents",
    "guardrails",
    "claude-code",
    "cursor",
    "codex",
    "antigravity",
    "qoder",
    "hooks",
    "safety",
    "cli"
  ],
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Utkarsh450/agent-guardrails-kit.git"
  },
  "homepage": "https://github.com/Utkarsh450/agent-guardrails-kit#readme",
  "bugs": {
    "url": "https://github.com/Utkarsh450/agent-guardrails-kit/issues"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "agent-guardrails-kit": "dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "node scripts/build.mjs && node dist/cli.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "diff": "9.0.0",
    "picocolors": "1.1.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
